NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/iitk-marketplace
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OTP_SECRET=replace-with-a-stable-random-secret
FRONTEND_URL=http://localhost:5173
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_USER=your-sending-gmail-address
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
SOLD_PRODUCT_RETENTION_DAYS=30
PRODUCT_CLEANUP_INTERVAL_MS=3600000
SEED_USER_PASSWORD=choose-a-password-for-new-seed-users
ALLOW_PRODUCTION_SEED=false
